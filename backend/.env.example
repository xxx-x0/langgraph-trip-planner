# Backend environment variables
# Copy this file to backend/.env and fill in the values marked CHANGE_ME.

# App
APP_NAME=HelloAgents智能旅行助手
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
# Leave blank/default to use backend/data/trips.db.
# Example: sqlite+aiosqlite:///./data/trips.db
DATABASE_URL=

# Required: AMap Web Service API key for MCP / POI / weather / routes.
AMAP_API_KEY=CHANGE_ME

# Required: OpenAI-compatible LLM provider.
# DeepSeek example:
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL_NAME=deepseek-chat
# DeepSeek V4 mode for interactive planning; use enabled for deliberate reasoning.
LLM_THINKING_MODE=disabled

# Optional aliases used by some OpenAI-compatible code paths.
# Keep these aligned with the LLM_* values unless you intentionally use a different provider.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Optional: AIGoHotel MCP endpoint.
# Set your own private ModelScope endpoint in backend/.env; no shared default is published.
AIGOHOTEL_MCP_URL=

# Optional: Bing MCP endpoint. Set your own private endpoint in backend/.env.
# Attraction search no longer uses Bing, but the service remains in the codebase for other possible usage.
BING_MCP_URL=

# Optional: Unsplash cover images.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Optional: set to 1 only when you want to run live smoke tests.
RUN_SMOKE_TESTS=0

# Structured output: json_prompt (safe default), auto (bounded probe + JSON fallback),
# or function_calling (try structured first; unsupported requests still fall back).
LLM_STRUCTURED_OUTPUT_MODE=json_prompt
# Total LLM deadline, including queueing and retries. SDK retries are disabled.
EXTERNAL_LLM_TIMEOUT=60

# Optional WindHub token for the Jev ticket recommendation option.
# WINDHUB_API_KEY=

# Travel-memory originals and derived previews (optional absolute local path).
# Default: backend/data/travel-memory-media. Keep this directory with trips.db.
# TRAVEL_MEMORY_STORAGE_DIR=/absolute/path/to/travel-memory-media
